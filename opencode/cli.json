{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "vague"
    },
    "diffs": {
        "wrap": "word"
    },
    "session": {
        "sidebar": "auto",
        "scrollbar": true,
        "thinking": "hide",
        "tps": true,
        "grouping": "auto"
    },
    "animations": true,
    "tabs": {
        "enabled": false
    },
    "keybinds": {
        "agent.cycle": "tab",
    },
}
