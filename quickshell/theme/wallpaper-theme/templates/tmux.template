set -gq @theme_surface "{{colors.surface.default.hex}}"
set -gq @theme_on_surface "{{colors.on_surface.default.hex}}"
set -gq @theme_surface_container_low "{{colors.surface_container_low.default.hex}}"
set -gq @theme_surface_container "{{colors.surface_container.default.hex}}"
set -gq @theme_surface_container_high "{{colors.surface_container_high.default.hex}}"
set -gq @theme_surface_container_highest "{{colors.surface_container_highest.default.hex}}"
set -gq @theme_on_surface_variant "{{colors.on_surface_variant.default.hex}}"
set -gq @theme_outline "{{colors.outline.default.hex}}"
set -gq @theme_outline_variant "{{colors.outline_variant.default.hex}}"
set -gq @theme_primary "{{colors.primary.default.hex}}"
set -gqF status-style "bg=#{@theme_surface_container_low},fg=#{@theme_on_surface}"
set -gqF window-status-style "bg=#{@theme_surface_container},fg=#{@theme_on_surface_variant}"
set -gqF window-status-current-style "bg=#{@theme_surface_container_highest},fg=#{@theme_on_surface},bold"
set -gqF pane-border-style "fg=#{@theme_outline_variant}"
set -gqF pane-active-border-style "fg=#{@theme_primary}"
set -gqF mode-style "bg=#{@theme_primary},fg=#{@theme_surface}"
