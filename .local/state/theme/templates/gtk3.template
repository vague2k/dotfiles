/* Generated by matugen from the wallpaper palette. Edits are overwritten the
 * next time a wallpaper is applied, change templates/gtk3.template instead.
 *
 * GTK3 has no CSS custom properties, so everything is @define-color here and
 * widgets.css references the names with @. Same roles as the GTK4 vars file. */

/* --- standard GTK3 / Adwaita names --- */
@define-color theme_bg_color {{colors.surface_container_low.default.hex}};
@define-color theme_fg_color {{colors.on_surface.default.hex}};
@define-color theme_base_color {{colors.surface.default.hex}};
@define-color theme_text_color {{colors.on_surface.default.hex}};
/* selected is the muted surface, not the accent, so list/tree selections match
 * the GTK4 side. Text selection is forced back to the accent in widgets.css.
 * Thunar in particular reads theme_selected_bg_color and
 * theme_unfocused_selected_bg_color to paint its own selection. */
@define-color theme_selected_bg_color {{colors.surface_container_highest.default.hex}};
@define-color theme_selected_fg_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_bg_color {{colors.surface_container_low.default.hex}};
@define-color theme_unfocused_fg_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_base_color {{colors.surface.default.hex}};
@define-color theme_unfocused_text_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_selected_bg_color {{colors.surface_container_highest.default.hex}};
@define-color theme_unfocused_selected_fg_color {{colors.on_surface.default.hex}};
@define-color insensitive_bg_color {{colors.surface_container.default.hex}};
@define-color insensitive_base_color {{colors.surface.default.hex}};
@define-color insensitive_fg_color {{colors.outline.default.hex}};
@define-color unfocused_borders {{colors.outline_variant.default.hex}};
@define-color error_color {{colors.error.default.hex}};
@define-color warning_color {{colors.tertiary.default.hex}};
@define-color success_color {{colors.tertiary.default.hex}};
@define-color borders {{colors.outline_variant.default.hex}};
@define-color outline_color {{colors.outline.default.hex}};
@define-color content_view_bg {{colors.surface.default.hex}};
@define-color text_view_bg {{colors.surface.default.hex}};

/* --- design colors consumed by widgets.css --- */
@define-color vague_base {{colors.surface_container_low.default.hex}};
@define-color vague_surface {{colors.surface_container.default.hex}};
@define-color vague_surface_low {{colors.surface.default.hex}};
@define-color vague_inset {{colors.surface_container_lowest.default.hex}};
@define-color vague_hover {{colors.surface_container_high.default.hex}};
@define-color vague_selected {{colors.surface_container_highest.default.hex}};
@define-color vague_border {{colors.outline_variant.default.hex}};
@define-color vague_border_strong {{colors.outline.default.hex}};
@define-color vague_text {{colors.on_surface.default.hex}};
@define-color vague_text_dim {{colors.on_surface_variant.default.hex}};
@define-color vague_text_muted {{colors.outline.default.hex}};
@define-color vague_accent {{colors.primary.default.hex}};
@define-color vague_on_accent {{colors.on_primary.default.hex}};
@define-color vague_accent_alt {{colors.tertiary.default.hex}};
@define-color vague_red {{colors.error.default.hex}};
@define-color vague_on_red {{colors.on_error.default.hex}};
