/* Generated by matugen from the wallpaper palette. Edits are overwritten the
 * next time a wallpaper is applied, change templates/gtk4.template instead.
 *
 * Two layers on purpose:
 *   1. @define-color names that libadwaita and plain GTK4 read.
 *   2. --vague-* custom properties (GTK >= 4.16) that widgets.css uses.
 * The quickshell panel maps its surface roles the same way, see Theme.qml. */

/* --- libadwaita / GTK4 named colors --- */
@define-color accent_color {{colors.primary.default.hex}};
@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};
@define-color destructive_bg_color {{colors.error.default.hex}};
@define-color destructive_fg_color {{colors.on_error.default.hex}};
@define-color error_bg_color {{colors.error.default.hex}};
@define-color error_fg_color {{colors.on_error.default.hex}};
@define-color window_bg_color {{colors.surface_container_low.default.hex}};
@define-color window_fg_color {{colors.on_surface.default.hex}};
@define-color view_bg_color {{colors.surface.default.hex}};
@define-color view_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_bg_color {{colors.surface_container.default.hex}};
@define-color headerbar_fg_color {{colors.on_surface.default.hex}};
@define-color popover_bg_color {{colors.surface_container.default.hex}};
@define-color popover_fg_color {{colors.on_surface.default.hex}};
@define-color card_bg_color {{colors.surface_container.default.hex}};
@define-color card_fg_color {{colors.on_surface.default.hex}};
@define-color dialog_bg_color {{colors.surface_container_low.default.hex}};
@define-color dialog_fg_color {{colors.on_surface.default.hex}};
@define-color sidebar_bg_color {{colors.surface_container.default.hex}};
@define-color sidebar_fg_color {{colors.on_surface.default.hex}};
@define-color borders {{colors.outline_variant.default.hex}};
@define-color outline_color {{colors.outline.default.hex}};
@define-color theme_bg_color {{colors.surface_container_low.default.hex}};
@define-color theme_fg_color {{colors.on_surface.default.hex}};
@define-color theme_base_color {{colors.surface.default.hex}};
@define-color theme_text_color {{colors.on_surface.default.hex}};
@define-color theme_selected_bg_color {{colors.surface_container_highest.default.hex}};
@define-color theme_selected_fg_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_selected_bg_color {{colors.surface_container_highest.default.hex}};
@define-color theme_unfocused_selected_fg_color {{colors.on_surface.default.hex}};
@define-color insensitive_bg_color {{colors.surface_container.default.hex}};
@define-color insensitive_fg_color {{colors.outline.default.hex}};
@define-color warning_color {{colors.tertiary.default.hex}};
@define-color error_color {{colors.error.default.hex}};
@define-color success_color {{colors.tertiary.default.hex}};

/* --- design vars consumed by widgets.css --- */
:root {
  --vague-bg-base: {{colors.surface_container_low.default.hex}};
  --vague-bg-surface: {{colors.surface_container.default.hex}};
  --vague-bg-surface-low: {{colors.surface.default.hex}};
  --vague-bg-inset: {{colors.surface_container_lowest.default.hex}};
  --vague-bg-hover: {{colors.surface_container_high.default.hex}};
  --vague-bg-selected: {{colors.surface_container_highest.default.hex}};
  --vague-border: {{colors.outline_variant.default.hex}};
  --vague-border-strong: {{colors.outline.default.hex}};
  --vague-text: {{colors.on_surface.default.hex}};
  --vague-text-dim: {{colors.on_surface_variant.default.hex}};
  --vague-text-muted: {{colors.outline.default.hex}};
  --vague-accent: {{colors.primary.default.hex}};
  --vague-on-accent: {{colors.on_primary.default.hex}};
  --vague-accent-alt: {{colors.tertiary.default.hex}};
  --vague-red: {{colors.error.default.hex}};
  --vague-on-red: {{colors.on_error.default.hex}};

  /* Adwaita and libadwaita style most widgets through these standard custom
   * properties. Defining them here makes their rules pick up the palette too,
   * instead of only the rules we spell out in widgets.css. */
  --accent-color: {{colors.primary.default.hex}};
  --accent-bg-color: {{colors.primary.default.hex}};
  --accent-fg-color: {{colors.on_primary.default.hex}};
  --destructive-bg-color: {{colors.error.default.hex}};
  --destructive-fg-color: {{colors.on_error.default.hex}};
  --error-bg-color: {{colors.error.default.hex}};
  --error-fg-color: {{colors.on_error.default.hex}};
  --warning-bg-color: {{colors.tertiary.default.hex}};
  --warning-fg-color: {{colors.on_tertiary.default.hex}};
  --window-bg-color: {{colors.surface_container_low.default.hex}};
  --window-fg-color: {{colors.on_surface.default.hex}};
  --view-bg-color: {{colors.surface.default.hex}};
  --view-fg-color: {{colors.on_surface.default.hex}};
  --headerbar-bg-color: {{colors.surface_container.default.hex}};
  --headerbar-fg-color: {{colors.on_surface.default.hex}};
  --popover-bg-color: {{colors.surface_container.default.hex}};
  --popover-fg-color: {{colors.on_surface.default.hex}};
  --dialog-bg-color: {{colors.surface_container_low.default.hex}};
  --dialog-fg-color: {{colors.on_surface.default.hex}};
  --card-bg-color: {{colors.surface_container.default.hex}};
  --card-fg-color: {{colors.on_surface.default.hex}};
  --sidebar-bg-color: {{colors.surface_container.default.hex}};
  --sidebar-fg-color: {{colors.on_surface.default.hex}};
  --secondary-sidebar-bg-color: {{colors.surface_container_low.default.hex}};
  --overview-bg-color: {{colors.surface_container_low.default.hex}};
  --scrollbar-outline-color: {{colors.outline_variant.default.hex}};
  --shade-color: rgba(0, 0, 0, 0.36);

  /* libadwaita recolors the headerbar and sidebars in backdrop through these
   * variables. Point them at the normal surfaces so an unfocused window does
   * not get a neutral grey patch. */
  --headerbar-backdrop-color: {{colors.surface_container.default.hex}};
  --headerbar-border-color: {{colors.outline_variant.default.hex}};
  --sidebar-backdrop-color: {{colors.surface_container.default.hex}};
  --secondary-sidebar-backdrop-color: {{colors.surface_container_low.default.hex}};
  --border-opacity: 15%;

  /* static shape tokens, same values the panels hardcode */
  --vague-radius: 0px;
  --vague-border-width: 1px;
}
